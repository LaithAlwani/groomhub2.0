# GroomHub env vars
#
# This file documents every env var the app uses and where each one belongs.
# For LOCAL development: copy to `.env.local` and fill in real values for the
# rows marked "Local". For PRODUCTION: set the rows marked "Vercel" in the
# Vercel project settings, and the rows marked "Convex" in the Convex
# deployment env (`npx convex env set NAME value` or the Convex dashboard).
#
# ┌─────────────────────────────────────────┬───────┬────────┬────────┐
# │ Variable                                │ Local │ Vercel │ Convex │
# ├─────────────────────────────────────────┼───────┼────────┼────────┤
# │ CONVEX_DEPLOYMENT                       │  yes  │   —    │   —    │
# │ NEXT_PUBLIC_CONVEX_URL                  │  yes  │  yes   │   —    │
# │ CONVEX_DEPLOY_KEY                       │   —   │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY       │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_IN_URL           │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_UP_URL           │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_…URL    │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_…URL    │  yes  │  yes   │   —    │
# │ CLERK_SECRET_KEY                        │  yes  │  yes   │  yes   │
# │ CLERK_JWT_ISSUER_DOMAIN                 │   —   │   —    │  yes   │
# │ CLERK_WEBHOOK_SIGNING_SECRET            │   —   │   —    │  yes   │
# │ RESEND_API_KEY                          │   —   │   —    │  yes   │
# │ RESEND_FROM_ADDRESS                     │   —   │   —    │  yes   │
# └─────────────────────────────────────────┴───────┴────────┴────────┘
#
# Rules of thumb:
#   - NEXT_PUBLIC_* gets bundled into the browser JS, so it lives wherever
#     Next.js builds (local + Vercel). Never put secrets here.
#   - Anything read by code in `convex/*.ts` lives in the Convex dashboard.
#   - CLERK_SECRET_KEY is the one var that lives in BOTH Vercel and Convex:
#     Next.js's server SDK uses it for `auth()` / `clerkMiddleware()`, and
#     `convex/invitations.ts` uses it to call Clerk's Backend API.
#   - CONVEX_DEPLOYMENT is only for the `npx convex dev` CLI on your laptop.
#     Vercel doesn't need it — it uses CONVEX_DEPLOY_KEY instead.


# ─── Convex ─────────────────────────────────────────────────────────────
# Local-only. Auto-populated by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=

# Local + Vercel. The wss/https URL the Convex React client connects to.
# Auto-populated by `npx convex dev`. For production, set this in Vercel
# to your prod deployment URL (e.g. https://acme-foo-123.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://...convex.cloud

# Vercel-only. A deploy key from `npx convex deploy-key generate` (Convex
# dashboard → Settings → Deploy Keys). Vercel uses it during the build step:
#   "buildCommand": "npx convex deploy --cmd 'npm run build'"
# Don't put this in `.env.local`.
CONVEX_DEPLOY_KEY=


# ─── Clerk (frontend) ───────────────────────────────────────────────────
# Local + Vercel. Public publishable key from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Local + Vercel. Tell Clerk where our custom auth pages live so OAuth
# transfers and "continue sign-up" never fall back to Clerk's hosted Account
# Portal (accounts.<app>.clerk.accounts.dev).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Local + Vercel + Convex. Server-side Clerk secret key. Used by:
#   - `@clerk/nextjs/server` (auth(), clerkMiddleware, currentUser)
#   - `convex/invitations.ts` to look up an invited email via the Clerk REST API
# Set the same value in all three places.
CLERK_SECRET_KEY=sk_test_...


# ─── Clerk (Convex backend) ─────────────────────────────────────────────
# Convex-only. The `iss` claim from the Clerk JWT, e.g.
#   https://<your-instance>.clerk.accounts.dev
# Convex needs it to verify session tokens and to derive the
# tokenIdentifier in webhook handlers. Set via:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<...>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Convex-only. `whsec_...` from the Clerk webhook config page (Clerk dashboard
# → Webhooks → your endpoint). Used by `convex/http.ts` to verify the Svix
# signature on every incoming Clerk webhook. Without it the webhook 500s.
# The webhook URL itself is https://<deployment>.convex.site/clerk-webhook.
CLERK_WEBHOOK_SIGNING_SECRET=


# ─── Resend (transactional email) ───────────────────────────────────────
# Convex-only. API key from https://resend.com/api-keys. If unset, the
# `convex/email.ts` actions log a warning and skip the send so dev keeps
# working without it.
RESEND_API_KEY=

# Convex-only, optional. Override the From header on outbound mail. Defaults
# to `GroomHub <onboarding@resend.dev>` which only delivers back to the
# Resend account owner — use a verified-domain address for real customers,
# e.g. `Posh Paws <bookings@poshpaws.app>`.
RESEND_FROM_ADDRESS=
