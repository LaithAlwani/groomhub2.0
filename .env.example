# GroomHub env vars
#
# This file documents every env var the app uses and where each one belongs.
# For LOCAL development: copy to `.env.local` and fill in real values for the
# rows marked "Local". For PRODUCTION: set the rows marked "Vercel" in the
# Vercel project settings, and the rows marked "Convex" in the Convex
# deployment env (`npx convex env set NAME value` or the Convex dashboard).
#
# ┌─────────────────────────────────────────┬───────┬────────┬────────┐
# │ Variable                                │ Local │ Vercel │ Convex │
# ├─────────────────────────────────────────┼───────┼────────┼────────┤
# │ CONVEX_DEPLOYMENT                       │  yes  │   —    │   —    │
# │ NEXT_PUBLIC_CONVEX_URL                  │  yes  │  yes   │   —    │
# │ CONVEX_DEPLOY_KEY                       │   —   │  yes   │   —    │
# │ ROOT_DOMAIN                             │   —   │  yes   │   —    │
# │ NEXT_PUBLIC_ROOT_DOMAIN                 │   —   │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY       │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_IN_URL           │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_UP_URL           │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_…URL    │  yes  │  yes   │   —    │
# │ NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_…URL    │  yes  │  yes   │   —    │
# │ CLERK_SECRET_KEY                        │  yes  │  yes   │  yes   │
# │ CLERK_JWT_ISSUER_DOMAIN                 │   —   │   —    │  yes   │
# │ CLERK_WEBHOOK_SIGNING_SECRET            │   —   │   —    │  yes   │
# │ SMTP_HOST                               │   —   │   —    │  yes   │
# │ SMTP_PORT                               │   —   │   —    │  yes   │
# │ SMTP_USER                               │   —   │   —    │  yes   │
# │ SMTP_PASS                               │   —   │   —    │  yes   │
# │ EMAIL_FROM_ADDRESS                      │   —   │   —    │  yes   │
# │ EMAIL_FROM_NAME                         │   —   │   —    │  yes   │
# └─────────────────────────────────────────┴───────┴────────┴────────┘
#
# Rules of thumb:
#   - NEXT_PUBLIC_* gets bundled into the browser JS, so it lives wherever
#     Next.js builds (local + Vercel). Never put secrets here.
#   - Anything read by code in `convex/*.ts` lives in the Convex dashboard.
#   - CLERK_SECRET_KEY is the one var that lives in BOTH Vercel and Convex:
#     Next.js's server SDK uses it for `auth()` / `clerkMiddleware()`, and
#     `convex/invitations.ts` uses it to call Clerk's Backend API.
#   - CONVEX_DEPLOYMENT is only for the `npx convex dev` CLI on your laptop.
#     Vercel doesn't need it — it uses CONVEX_DEPLOY_KEY instead.


# ─── Convex ─────────────────────────────────────────────────────────────
# Local-only. Auto-populated by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=

# Local + Vercel. The wss/https URL the Convex React client connects to.
# Auto-populated by `npx convex dev`. For production, set this in Vercel
# to your prod deployment URL (e.g. https://acme-foo-123.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://...convex.cloud

# Vercel-only. A deploy key from `npx convex deploy-key generate` (Convex
# dashboard → Settings → Deploy Keys). Vercel uses it during the build step:
#   "buildCommand": "npx convex deploy --cmd 'npm run build'"
# Don't put this in `.env.local`.
CONVEX_DEPLOY_KEY=


# ─── Host split / white-label (Phase 00) ────────────────────────────────
# Vercel (+ optionally Local). The apex domain the product runs under. When set,
# the Edge middleware (`proxy.ts`) serves the marketing site on the apex
# (groomhub.ca / www) and the authenticated app on `app.<ROOT_DOMAIN>`, and
# bounces auth routes hit on the marketing host over to the app host.
#
# Leave BOTH UNSET for local dev and preview deploys: the app then serves
# marketing + app from a single host (today's behaviour), so nothing breaks.
#   - ROOT_DOMAIN            — read server-side by the middleware (inlined at build).
#   - NEXT_PUBLIC_ROOT_DOMAIN — read in the browser so marketing CTAs link straight
#                               to https://app.<root>/sign-in rather than relying on
#                               the middleware redirect. Set both to the SAME value.
# Example (production): ROOT_DOMAIN=groomhub.ca  NEXT_PUBLIC_ROOT_DOMAIN=groomhub.ca
ROOT_DOMAIN=
NEXT_PUBLIC_ROOT_DOMAIN=


# ─── Clerk (frontend) ───────────────────────────────────────────────────
# Local + Vercel. Public publishable key from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Local + Vercel. Tell Clerk where our custom auth pages live so OAuth
# transfers and "continue sign-up" never fall back to Clerk's hosted Account
# Portal (accounts.<app>.clerk.accounts.dev).
#
# With the host split (ROOT_DOMAIN set) auth lives only on the app host, so in
# PRODUCTION set these to absolute app-host URLs and add `app.<root>` to Clerk's
# allowed origins / redirect URLs:
#   NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://app.groomhub.ca/sign-in
#   NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://app.groomhub.ca/sign-up
# The relative paths below are correct for local dev (no split).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Local + Vercel + Convex. Server-side Clerk secret key. Used by:
#   - `@clerk/nextjs/server` (auth(), clerkMiddleware, currentUser)
#   - `convex/invitations.ts` to look up an invited email via the Clerk REST API
# Set the same value in all three places.
CLERK_SECRET_KEY=sk_test_...


# ─── Clerk (Convex backend) ─────────────────────────────────────────────
# Convex-only. The `iss` claim from the Clerk JWT, e.g.
#   https://<your-instance>.clerk.accounts.dev
# Convex needs it to verify session tokens and to derive the
# tokenIdentifier in webhook handlers. Set via:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<...>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Convex-only. `whsec_...` from the Clerk webhook config page (Clerk dashboard
# → Webhooks → your endpoint). Used by `convex/http.ts` to verify the Svix
# signature on every incoming Clerk webhook. Without it the webhook 500s.
# The webhook URL itself is https://<deployment>.convex.site/clerk-webhook.
CLERK_WEBHOOK_SIGNING_SECRET=


# ─── Transactional email (SMTP via nodemailer) ──────────────────────────
# All Convex-only. `convex/email.ts` runs in the Node runtime and uses these
# to open a single SMTP connection at module load. If any of HOST/PORT/USER/PASS
# is missing the actions log a warning and skip — dev / local works fine
# without email configured.
#
# Set these in Convex (the CLI reads `process.env.*` inside Convex actions):
#   npx convex env set SMTP_HOST smtp.zoho.com
#   npx convex env set SMTP_PORT 587
#   npx convex env set SMTP_USER support@meepletron.com
#   npx convex env set SMTP_PASS '<app-specific-password>'
# (Or in the Convex dashboard → Settings → Environment Variables.)
#
# Provider examples — pick the matching row:
#   - Zoho Mail (US):     smtp.zoho.com           587   support@yourdomain.com   <app-password>
#   - Zoho Mail (EU):     smtp.zoho.eu            587   support@yourdomain.com   <app-password>
#   - Zoho ZeptoMail:     smtp.zeptomail.com      587   <token-as-user>          <api-key>
#   - Brevo (Sendinblue): smtp-relay.brevo.com    587   <login>                  <smtp-key>
#   - Amazon SES:         email-smtp.us-east-1.amazonaws.com 587 <iam-key>       <iam-secret>
#   - Gmail (app pw):     smtp.gmail.com          587   you@gmail.com            <16-char-app-pw>
#
# Zoho Mail specifics:
#   - Get the app password from https://accounts.zoho.com/home#security/app_password
#     (Mode = Mail). Don't use your regular login password — Zoho refuses it for SMTP.
#   - SMTP_USER MUST be the full mailbox (`support@yourdomain.com`), not just the local
#     part. SMTP_PASS is the generated app password.
#   - The domain (yourdomain.com) must already be verified in Zoho with MX pointing there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Convex-only. The address the outbound mail actually comes from (must be
# verified at your SMTP provider — for Zoho, it must match SMTP_USER's
# mailbox or an alias of it). The shop's name is used as the From display
# name dynamically (e.g. "Posh Paws Grooming" <support@meepletron.com>);
# `EMAIL_FROM_NAME` is only used when no shop name is resolvable.
EMAIL_FROM_ADDRESS=support@meepletron.com
EMAIL_FROM_NAME=GroomHub
